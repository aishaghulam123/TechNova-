rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isSignedIn() && myProfile().role == "admin" && myProfile().status == "approved"; }
    function isApproved() { return isSignedIn() && myProfile().status == "approved"; }

    // ---- users ----
    // Anyone signed in can create their OWN profile during signup (always as pending, non-admin — enforced below).
    // Only the user themself or an admin can read it. Only an admin can approve/reject/suspend (change status/role).
    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid
                     && request.resource.data.status == "pending"
                     && request.resource.data.role != "admin";
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin()
                     || (isSignedIn() && request.auth.uid == uid
                         // a user may edit their own profile but never their own role/status
                         && request.resource.data.role == resource.data.role
                         && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // ---- courses ----
    // Public can read only approved courses. Instructor can read/manage their own. Admin can read/manage all.
    match /courses/{courseId} {
      allow read: if resource.data.status == "approved"
                   || (isSignedIn() && resource.data.instructorId == request.auth.uid)
                   || isAdmin();
      allow create: if isApproved() && myProfile().role == "instructor"
                     && request.resource.data.instructorId == request.auth.uid
                     && request.resource.data.status == "pending";
      allow update: if isAdmin()
                     || (isSignedIn() && resource.data.instructorId == request.auth.uid
                         // instructor edits their own course but can't self-approve
                         && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.instructorId == request.auth.uid);
    }

    // ---- enrollments ----
    // A student can create/read only their OWN enrollments. Admin can read all (reports).
    match /enrollments/{enrollId} {
      allow create: if isApproved() && request.resource.data.studentId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.studentId == request.auth.uid; // e.g. progress updates
      allow delete: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }
  }
}
